cssvrsc:e4940944a20f90dcd28ec5ccaa3bbd3cb74c15004568cc32968faeb0819a69a2 a cssv:Specification ;
    dct:relation [ dct:description "ADMS is an specification that implements shared platform ABB as it is the basis of the European Platform Joinup, being the Metadata, semantics & ontologies, interoperability data model for the description of Interoperable solutions (datasets). By providing a common way to describe, and index datasets or assets in human and readable format, it fosters the reuse of digital public services."@en ;
            dct:relation eira:SemanticInteroperabilityAgreementContract ],
        [ dct:description "By providing a common way to describe, and index datasets or assets in human and readable format, it fosters the reuse of digital public services. Moreover, it is the basis for the knowledge sharing and collaboration amongst European Administrations, business and other stakeholders."@en ;
            dct:relation eira:OntologyDataObject ],
        [ dct:description "Specification used for the description of catalogues, including catalogues of APIs."@en ;
            dct:relation eira:APICatalogueApplicationComponent ],
        [ dct:description "Specification used for the description of catalogues, including catalogues of APIs."@en ;
            dct:relation eira:APIDiscoveryAndCatalogueApplicationService ],
        [ dct:description "ADMS is a specification designed to support the publication, discovery, and reuse of interoperability assets such as metadata schemas, ontologies, taxonomies, and code lists. It provides structured metadata elements describing these assets, enabling catalogues to store, categorise, and expose them in a harmonised way. As a data publication component, ADMS improves the visibility and retrievability of interoperability assets, supporting federated catalogues and semantic interoperability across administrative domains."@en ;
            dct:relation eira:DataPublicationApplicationComponent ],
        [ dct:description "ADMS 1.0 focuses on enabling organisations to expose metadata about standards, semantic assets, and specifications. It acts as a service layer, providing a framework for the publication, federation, and synchronisation of metadata across different systems."@en ;
            dct:relation eira:DataPublicationApplicationService ],
        [ dct:description "ADMS 1.0 reflects its initial implementation, where its capabilities centre around managing the lifecycle of metadata, including versioning, updates, and changes. This component helps organisations maintain control over their metadata, ensuring that updates to standards and assets are consistently tracked and synchronised across distributed systems."@en ;
            dct:relation eira:MetadataManagementApplicationComponent ],
        [ dct:description "ADMS broadens its scope, providing the outward-facing functionality that enables organisations to publish and manage metadata effectively."@en ;
            dct:relation eira:MetadataManagementApplicationService ],
        [ dct:description "ADMS is an specification that implements shared platform ABB as it is the basis of the European Platform Joinup, being the Metadata, semantics & ontologies, interoperability data model for the description of Interoperable solutions (datasets). By providing a common way to describe, and index datasets or assets in human and readable format, it fosters the reuse of digital public services."@en ;
            dct:relation eira:LinkedDataRepresentation ],
        [ dct:description "ADMS is an specification that implements shared platform ABB as it is the basis of the European Platform Joinup, being the Metadata, semantics & ontologies, interoperability data model for the description of Interoperable solutions (datasets). By providing a common way to describe, and index datasets or assets in human and readable format, it fosters the reuse of digital public services."@en ;
            dct:relation eira:LinkedOpenDataRepresentation ],
        [ dct:description "ADMS is an specification that implements shared platform ABB as it is the basis of the European Platform Joinup, being the Metadata, semantics & ontologies, interoperability data model for the description of Interoperable solutions (datasets). By providing a common way to describe, and index datasets or assets in human and readable format, it fosters the reuse of digital public services."@en ;
            dct:relation eira:OpenDataRepresentation ],
        [ dct:description "ADMS provides a common way to describe and index datasets or assets in human and readable format."@en ;
            dct:relation eira:MetadataDataObject ],
        camssa:901981adc7391f00196e37c503e590da0e8a58b0418d1eb3f620fef747da8d31,
        camssa:f179e2320e04798b6243c7f08e8cd586aa7ca18f4951c0c0ba7a2afc7e9f3011 ;
    dcat:theme "Data Architecture"@en,
        "Implementation Governance"@en,
        "Technology Architecture"@en .

cssvrsc:e4f09a7e4ed379becfbe33fde381b5219e83adb71b921bfb7a861e7d9f394ab5 a cssv:Specification ;
    dct:relation [ dct:description "ISO/IEC/IEEE 15288:2023 provides processes that ensure effective connectivity and communication throughout the system's life cycle. The standard addresses requirements for network design, implementation, and maintenance, ensuring that network infrastructure is reliable, scalable, and secure."@en ;
            dct:relation eira:PhysicalNetworkInfrastructureEquipment ],
        [ dct:description "ISO/IEC/IEEE 15288:2023 outlines processes that ensure efficient handling of data processing, storage, and transmission throughout the system's life cycle. The standard emphasizes requirements engineering, system design, and integration, ensuring that computing infrastructure meets performance and reliability standards."@en ;
            dct:relation eira:PhysicalComputingInfrastructureEquipment ] ;
    dcat:theme "Technology Architecture"@en .

cssvrsc:e56c152b24acda08a37a0e99044a42e6eea9bde90c4b4629b6aa005d3c253d3d a cssv:Specification ;
    dct:relation [ dct:description "The ITU-T Y.3500 specification offers a foundational overview and vocabulary for cloud computing. It defines key terms and concepts related to cloud computing, ensuring a common understanding across industries, governments, and technology providers. "@en ;
            dct:relation eira:PublicCloudComputingFacilityFacility ],
        [ dct:description "The ITU-T Y.3500 specification offers a foundational overview and vocabulary for cloud computing. It defines key terms and concepts related to cloud computing, ensuring a common understanding across industries, governments, and technology providers."@en ;
            dct:relation eira:PrivateCloudComputingFacilityFacility ],
        [ dct:description "The ITU-T Y.3500 specification offers a foundational overview and vocabulary for cloud computing. It defines key terms and concepts related to cloud computing, ensuring a common understanding across industries, governments, and technology providers."@en ;
            dct:relation eira:ControlledVocabularyDataObject ],
        [ dct:description "The Y.3500 specification offers a foundational overview of cloud computing by providing standardised terminology and precise definitions. It serves as a common reference to help professionals and organisations better understand and communicate key concepts within the cloud computing domain."@en ;
            dct:relation eira:SemanticInteroperabilityAgreementContract ] ;
    dcat:theme "Data Architecture"@en,
        "Implementation Governance"@en,
        "Technology Architecture"@en .

cssvrsc:e57fea291208c8917fd7d5b30ed302d6498ed036acaf03eae5e56d672d1eb2bc a cssv:Specification ;
    dct:relation [ dct:description "The ETSI TS 103 846 specification is designed to define a reference architecture for Digital Twins (DTs). One of its core focuses is enabling data exchange between DTs to ensure effective communication and coordination. This allows DTs to adjust parameters in real time based on analysed data, for example, regulating temperature in a smart building according to occupancy or environmental conditions. By standardising these interactions, the specification supports intelligent automation and interoperability across platforms."@en ;
            dct:relation eira:DataExchangeApplicationComponent ],
        [ dct:description "The ETSI TS 103 846 specification is designed to define a reference architecture for Digital Twins (DTs). One of its core focuses is enabling data exchange between DTs to ensure effective communication and coordination. This allows DTs to adjust parameters in real time based on analysed data, for example, regulating temperature in a smart building according to occupancy or environmental conditions. By standardising these interactions, the specification supports intelligent automation and interoperability across platforms."@en ;
            dct:relation eira:DataExchangeApplicationService ],
        [ dct:description "The ETSI TS 103 846 specification sets out the reference architecture for the design of Digital Twins (DTs). One of the capabilities embedded in this design is the ability of DTs to analyse data from their operational environment. For example, in a smart home, a DT can assess environmental data and adjust parameters such as temperature to meet estimated needs. This predictive and adaptive functionality enhances responsiveness and supports intelligent automation."@en ;
            dct:relation eira:DataAnalyticsApplicationComponent ],
        [ dct:description "The ETSI TS 103 846 specification sets out the reference architecture for the design of Digital Twins (DTs). One of the capabilities embedded in this design is the ability of DTs to analyse data from their operational environment. For example, in a smart home, a DT can assess environmental data and adjust parameters such as temperature to meet estimated needs. This predictive and adaptive functionality enhances responsiveness and supports intelligent automation."@en ;
            dct:relation eira:DataAnalyticsApplicationService ],
        [ dct:description "ETSI TS 103 846 defines a reference architecture that enables Digital Twins (DTs) to communicate effectively with applications and other services. A key component is the Digital Interface (DI), which allows DTs to integrate seamlessly with various platforms and facilitates data exchange. The specification also promotes the use of standardised interfaces and shared descriptions to ensure interoperability. This includes the use of ontologies, which help stakeholders understand and interpret the capabilities of a DT consistently."@en ;
            dct:relation eira:MachineToMachineInterfaceApplicationInterface ],
        [ dct:description "The ETSI TS 103 846 specification not only addresses data exchange but also explicitly defines the fundamental elements, such as properties, events, actions, and relationships. These elements enable the standardised modelling and description of a Digital Twin’s knowledge domain. By incorporating ontologies, the specification ensures interoperability and shared understanding across diverse platforms and contexts."@en ;
            dct:relation eira:OntologyDataObject ],
        [ dct:description "The ETSI TS 103 846 specification defines the reference architecture for Digital Twins, including capabilities such as data analysis. It specifies that Digital Twins can collect and interpret data from their environment and make adjustments accordingly, for example, adapting the temperature in a smart building to meet real-time needs."@en ;
            dct:relation eira:EventManagerTechnologyService ],
        [ dct:description "The ETSI TS 103 846 specification defines a reference architecture for Digital Twins (DTs), enabling them to interact effectively with applications and services. One of the key capabilities of DTs is their ability to make predictions based on analysed data from their deployment environment. For instance, a DT monitoring road usage could forecast air pollution levels in the coming hours. This predictive functionality supports real-time decision-making and enhances situational awareness."@en ;
            dct:relation eira:AIModelInferenceTechnologyService ],
        [ dct:description "The ETSI TS 103 846 specification defines a reference architecture for Digital Twins (DTs), enabling them to interact effectively with applications and services. One of the key capabilities of DTs is their ability to make predictions based on analysed data from their deployment environment. For instance, a DT monitoring road usage could forecast air pollution levels in the coming hours. This predictive functionality supports real-time decision-making and enhances situational awareness."@en ;
            dct:relation eira:MachineLearningTechnologyService ] ;
    dcat:theme "Data Architecture"@en,
        "Technology Architecture"@en .

cssvrsc:e5910967202d9f2b17572731ab8250fbcb581359d59e2f1472fa3b610a7527d2 a cssv:Specification ;
