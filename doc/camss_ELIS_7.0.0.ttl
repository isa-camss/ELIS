cssvrsc:43c225a0b3a969615a19f525ad19d49bc0916e190f06ff374b7ab3ea7fe8ee99 a cssv:Specification ;
    dct:relation [ dct:description "The RFC 7668 specification is designed to facilitate communication between Bluetooth Low Energy (BLE) devices by providing them with IPv6 connectivity. In this way, the specification allows devices to exchange data over an IP-based network. It defines how devices format messages, discover each other, and assign addresses so that data can flow reliably between them."@en ;
            dct:relation eira:DataExchangeApplicationComponent ],
        [ dct:description "The RFC 7668 specification is designed to facilitate communication between Bluetooth Low Energy (BLE) devices by providing them with IPv6 connectivity. In this way, the specification allows devices to exchange data over an IP-based network. It defines how devices format messages, discover each other, and assign addresses so that data can flow reliably between them. "@en ;
            dct:relation eira:DataExchangeApplicationService ],
        [ dct:description "The RFC 7668 specification defines rules that allow Bluetooth Low Energy (BLE) devices to communicate over IPv6 networks, specifying how they format messages, discover each other, and assign addresses, enabling them to interact reliably within IP-based systems."@en ;
            dct:relation eira:APIApplicationInterface ],
        [ dct:description "The RFC 7668 specification enables Bluetooth Low Energy (BLE) devices to communicate by providing them with IPv6 connectivity. In this way, the specification ensures that devices can operate efficiently both individually and in groups, allowing applications and users on the network to interact with them indirectly. Although it does not focus on direct communication between users, it facilitates interaction between devices on the network. "@en ;
            dct:relation eira:PhysicalNetworkInfrastructureEquipment ] ;
    dcat:theme "Technology Architecture"@en .

cssvrsc:4436eacc9ca95a0a58e5e7992d9b210830720a4aeec5009ed5ef7437b80f3987 a cssv:Specification ;
    dct:relation [ dct:description "A European legal act defining obligations for interoperable electronic communications services."@en ;
            dct:relation eira:EuropeanLegalActRequirement ],
        [ dct:description "Non-binding guidance proposing communications-related requirements that may be adopted nationally."@en ;
            dct:relation eira:Non-bindingInstrumentRequirement ],
        [ dct:description "This Directive consolidates and modernises rules governing electronic communications networks and services, including interoperability-related obligations, to ensure consistent, reliable digital communications across the internal market."@en ;
            dct:relation eira:BindingInstrumentRequirement ],
        [ dct:description "National-level requirement defining obligations for interoperable electronic communications services."@en ;
            dct:relation eira:NationalLegalActRequirement ],
        [ dct:description "This Directive establishes a harmonised regulatory framework for electronic communications networks and services, promoting interoperability, consumer protection, and consistent cross-border digital communications across the Union."@en ;
            dct:relation eira:LegalActRequirement ] ;
    dcat:theme "Business Architecture"@en .

