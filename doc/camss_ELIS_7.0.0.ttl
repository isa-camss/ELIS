    dct:relation [ dct:description "National-level requirement establishing obligations for interoperable skills and qualifications services."@en ;
            dct:relation eira:NationalLegalActRequirement ],
        [ dct:description "A binding instrument defining obligations for interoperability of skills and qualifications services."@en ;
            dct:relation eira:BindingInstrumentRequirement ],
        [ dct:description "This Decision defines a unified interoperability framework for skills and qualifications information, setting obligations for harmonised and cross-border service delivery in the Europass ecosystem."@en ;
            dct:relation eira:LegalActRequirement ],
        [ dct:description "Non-binding guidance proposing requirements for skills and qualifications services."@en ;
            dct:relation eira:Non-bindingInstrumentRequirement ],
