    dct:relation [ dct:description "The X.1752 specification enables the integration of security capabilities such as access control, encryption, isolation, and monitoring into the design of distributed big data environments to protect big data infrastructures and platforms from threats."@en ;
            dct:relation eira:SecurityFrameworkBusinessObject ],
        [ dct:description "The X.1752 specification enables the integration and  implementation of procedural services for monitoring big data infrastructures and platforms, ensuring security or compliance with standards, regulations, and best practices."@en ;
            dct:relation eira:AuditApplicationComponent ],
        [ dct:description "The X.1752 specification enables the implementation of comprehensive procedural services capable of receiving inputs from  big data infrastructures and platforms to ensure their correct behaviour, security or compliance with standards, regulations and best practices."@en ;
            dct:relation eira:AuditApplicationService ] ;
