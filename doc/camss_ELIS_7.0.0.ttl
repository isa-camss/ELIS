            dct:relation eira:MetadataManagementApplicationComponent ],
        [ dct:description "This profile defines how OGC Catalogue Services should handle ISO 19115/19119 metadata, specifying service operations, bindings, and processing models for geospatial metadata management. It guides the implementation of catalogue services capable of interoperable metadata discovery, retrieval, and service chaining in distributed spatial data infrastructures."@en ;
