cssvrsc:9eee7b5f591edb9c84e3d07d234b97ce0f5e84c26989b649ac96715af0adf328 a cssv:Specification ;
    dct:relation [ dct:description "Non-binding guidance proposing rules applicable in certain national scenarios."@en ;
            dct:relation eira:Non-bindingInstrumentRequirement ],
        [ dct:description "A European legal act establishing obligations for online services and information society rules."@en ;
            dct:relation eira:EuropeanLegalActRequirement ],
        [ dct:description "National-level requirement defining obligations for online information society services."@en ;
            dct:relation eira:NationalLegalActRequirement ],
        [ dct:description "This Directive sets foundational rules for information society services and online commercial practices, establishing interoperability-related obligations to support the free movement of digital services in the internal market."@en ;
            dct:relation eira:BindingInstrumentRequirement ],
        [ dct:description "This Directive sets foundational rules for the functioning of information society services, enabling interoperable digital markets by harmonising liability, transparency, and trust requirements for online service providers."@en ;
            dct:relation eira:LegalActRequirement ] ;
    dcat:theme "Business Architecture"@en .

cssvrsc:9f20060720cf509194734e94953c33a87e28b82bebad2ea64ba192e1ade4e4bf a cssv:Specification ;
    dct:relation [ dct:description "A non-binding communication setting strategic directions for EU digital transformation."@en ;
            dct:relation eira:Non-bindingInstrumentRequirement ] ;
