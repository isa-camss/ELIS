cssvrsc:5373b170e5317c1c4e73551703f4880d871ccbe1d710847974a494c58643b13d a cssv:Specification ;
    dct:relation [ dct:description "The Extended Log File Format specification standardises how web servers record log data, helping to organise and store logs consistently for easier processing and sharing. This supports better handling of server activity information. However, it does not cover broader data management tasks such as governance or lifecycle management. While it is a useful tool for managing log data, it is not a complete data management solution by itself."@en ;
            dct:relation eira:DataManagementApplicationComponent ],
        [ dct:description "The Extended Log File Format specification standardises how web servers record log data, helping to organise and store logs consistently for easier processing and sharing. This supports better handling of server activity information. However, it does not cover broader data management tasks such as governance or lifecycle management. While it is a useful tool for managing log data, it is not a complete data management solution by itself."@en ;
            dct:relation eira:DataManagementApplicationService ],
        [ dct:description "The Extended Log File Format specification supports measuring and analysing information about IT platforms by providing a standardised way to record detailed web server logs. This makes it easier for monitoring tools to track performance and identify issues."@en ;
            dct:relation eira:TelemetryTechnologyService ] ;
    dcat:theme "Technology Architecture"@en .

cssvrsc:539b0ea4eb21104f85de822c93b21e8d564c92ec514bd462c95addb1dc315ae6 a cssv:Specification ;
    dct:relation [ dct:description "RTP facilitates the transmission of live audio and video data, enabling real-time communication and media streaming services across networks with support for packet reordering, loss handling, and synchronization."@en ;
            dct:relation eira:StreamingServerTechnologyService ],
        [ dct:description "RTP breaks data (audio and video) into separate packets (blocks) for transmission over networks. Each packet includes a sequence number (acting as a unique identifier) to allow receivers to reorder packets and manage data timing and synchronization effectively."@en ;
            dct:relation eira:BlockStorageTechnologyService ] ;
    dcat:theme "Technology Architecture"@en .

cssvrsc:54243ab89d05b47f1e9bb30be798056515abf9bb6ab8c0e407ef1431e2818e1b a cssv:Specification ;
    dct:relation [ dct:description "The GSMA IoT Big Data Harmonized Data Model enhances the ability to perform analytics on IoT data, improving insights and decision-making processes."@en ;
            dct:relation eira:MachineToMachineInterfaceApplicationInterface ],
