cssvrsc:1be69ec52c743a85d06e01cac0710095c340643c5fbe90fcff3d9aa7bd395f16 a cssv:Specification ;
    dct:relation [ dct:description "The TGF describes the characteristics and requirements of a government in its transition to a transformantional government. According to OASIS, a Transformational Government is a managed, citizen-centric, process of ICT-enabled change within the public sector and in its relationships with the private and voluntary sectors, which puts the needs of citizens and businesses at the heart of that process and which achieves significant and transformational impacts on the efficiency and effectiveness of government."@en ;
            dct:relation eira:AdaptiveConfigurationBusinessInterface ],
        [ dct:description "The TGF proposes a citizen and business model to enable an organisational point of view to design service delivery enablers, such as catalogues, in order to achieve a transformantional government."@en ;
            dct:relation eira:DigitalPublicServiceCatalogueBusinessObject ],
        [ dct:description "The TGF proposes a citizen and business model to enable an organisational point of view to design service delivery enablers, such as catalogues, in order to achieve a transformantional government."@en ;
            dct:relation eira:DigitalPublicServiceDeliveryBusinessInterface ],
        [ dct:description "The TGF describes the characteristics and requirements of a government in its transition to a transformantional government. According to OASIS, a Transformational Government is a managed, citizen-centric, process of ICT-enabled change within the public sector and in its relationships with the private and voluntary sectors, which puts the needs of citizens and businesses at the heart of that process and which achieves significant and transformational impacts on the efficiency and effectiveness of government."@en ;
            dct:relation eira:DesktopAppBusinessInterface ],
        [ dct:description "The TGF describes the characteristics and requirements of a government in its transition to a transformantional government. According to OASIS, a Transformational Government is a managed, citizen-centric, process of ICT-enabled change within the public sector and in its relationships with the private and voluntary sectors, which puts the needs of citizens and businesses at the heart of that process and which achieves significant and transformational impacts on the efficiency and effectiveness of government."@en ;
            dct:relation eira:MobileAppBusinessInterface ],
        [ dct:description "The TGF describes the characteristics and requirements of a government in its transition to a transformantional government. According to OASIS, a Transformational Government is a managed, citizen-centric, process of ICT-enabled change within the public sector and in its relationships with the private and voluntary sectors, which puts the needs of citizens and businesses at the heart of that process and which achieves significant and transformational impacts on the efficiency and effectiveness of government."@en ;
            dct:relation eira:ServiceAppBusinessInterface ],
        [ dct:description "The TGF propose a citizen and business model to enable the transition to a transformantional government."@en ;
            dct:relation eira:DigitalPublicServiceBusinessService ],
        [ dct:description "The TGF describes the characteristics and requirements of a government in its transition to a transformantional government. According to OASIS, a Transformational Government is a managed, citizen-centric, process of ICT-enabled change within the public sector and in its relationships with the private and voluntary sectors, which puts the needs of citizens and businesses at the heart of that process and which achieves significant and transformational impacts on the efficiency and effectiveness of government."@en ;
            dct:relation eira:WebAppBusinessInterface ],
        [ dct:description "The TGF describes common characteristics and requirements of a government in its transition to a transformantional government as a managed, citizen-centric, process of ICT-enabled change within the public sector."@en ;
            dct:relation eira:DigitalGovernancePlanBusinessObject ],
        [ dct:description "The TGF provides comprehensive guidelines for technology-enabled change, ensuring effective governance and structured implementation of digital public services. This specification fosters improved public sector relations with society through well-defined contractual and operational frameworks."@en ;
            dct:relation eira:AgreementOnProvisionOfDigitalPublicServicesContract ],
        [ dct:description "The TGF describes the characteristics and requirements of a government in its transition to a transformantional governmen, achieving significant and transformational impacts on the efficiency and effectiveness of government."@en ;
            dct:relation eira:InteroperabilityFrameworkBusinessObject ],
        [ dct:description "The TGF outlines a high-level strategy and vision for achieving long-term business goals through digital initiatives, ensuring that the public sector can effectively plan and drive digital initiatives to achieve their strategic objectives."@en ;
            dct:relation eira:DigitalisationRoadmapWorkPackage ],
        [ dct:description "The Transformational Government Framework Version 2.0 is the high-level vision and strategy referring to the long-term business goal any organisation wants to achieve, including digital initiatives and goals the organisation will drive. In addition, it is designed for planning and delivering effective technology-enabled change within government at national, state, or local levels"@en ;
            dct:relation eira:DigitalisationRoadmapWorkPackage ],
        [ dct:description "The Transformational Government Framework Version 2.0 is a formalisation of the governance rules and conditions for the functioning of digital public services. It describes a managed process of ICT-enabled change within the public sector and in its relationships with the private and voluntary sectors, placing the needs of citizens and businesses at the heart of the process and achieving significant, transformational improvements in the efficiency and effectiveness of government."@en ;
            dct:relation eira:AgreementOnProvisionOfDigitalPublicServicesContract ],
        camssa:f6efbe4171aa8c758833c2869759497c15824db872a192682b28d93daa3cf03e ;
    dcat:theme "Business Architecture"@en,
        "Implementation Governance"@en .

cssvrsc:1c2ed9427d6d77f72664da4e7b01f07ceaa893deddd6c91431b2cf6e2ea10450 a cssv:Specification ;
    dct:relation [ dct:description "The Asset Description Metadata Schema (ADMS) functions as a semantic interoperability agreement that formalises the governance rules for describing interoperable solutions. It acts as a binding contract that enables digital public services to collaborate effectively and reuse assets within the European Platform Joinup."@en ;
            dct:relation eira:SemanticInteroperabilityAgreementContract ],
        [ dct:description "The Asset Description Metadata Schema (ADMS) operates as a semantic object that provides the necessary primitives to model the characteristics of public service assets. This framework ensures that datasets are described and indexed consistently, creating a robust environment that supports the discovery and reuse of solutions across the public sector."@en ;
            dct:relation eira:OntologyDataObject ],
        [ dct:description "The Asset Description Metadata Schema (ADMS) offers a standardised way to describe collections of software interfaces, ensuring that component functionalities are clearly defined and aligned with digital service structures."@en ;
            dct:relation eira:APICatalogueApplicationComponent ],
        [ dct:description "The Asset Description Metadata Schema (ADMS) allows the service to identify and manage API catalogues by providing a consistent schema for their representation, thereby facilitating the automated maintenance and discovery of digital assets."@en ;
            dct:relation eira:APIDiscoveryAndCatalogueApplicationService ],
        [ dct:description "The Asset Description Metadata Schema (ADMS) supplies structured metadata elements that enable the process of making interoperability assets available through mechanisms that are inherently discoverable and reusable."@en ;
            dct:relation eira:DataPublicationApplicationComponent ],
        [ dct:description "The Asset Description Metadata Schema (ADMS) allow organisations to expose and federate metadata, ensuring that semantic assets are made available in a manner that guarantees their discoverability and standardised reuse across different environments."@en ;
            dct:relation eira:DataPublicationApplicationService ],
        [ dct:description "The Asset Description Metadata Schema (ADMS) primary focus is on managing the lifecycle, including versioning and updates, ensuring that the retrieval and categorisation of metadata remain accurate and synchronised across distributed systems."@en ;
            dct:relation eira:MetadataManagementApplicationComponent ],
        [ dct:description "The Asset Description Metadata Schema (ADMS) serves as the enabling service for the metadata lifecycle. It provides the functional framework that allows organisations to execute the creation, storage, and categorisation of asset descriptions, while also facilitating the efficient retrieval of this information to support broader interoperability."@en ;
            dct:relation eira:MetadataManagementApplicationService ],
        [ dct:description "The Asset Description Metadata Schema (ADMS) specification functions as a key enabler for linked data technologies by providing a common vocabulary for describing datasets. Also, ADMS ensures that public service assets are indexed in a structured, human-readable format, creating a web of interlinked data that fosters discovery and reuse among administrations."@en ;
            dct:relation eira:LinkedDataRepresentation ],
        [ dct:description "The Asset Description Metadata Schema (ADMS) facilitates the enrichment of structured data by providing a standardised model, ensuring assets are connected to other informational resources and easily found."@en ;
            dct:relation eira:LinkedOpenDataRepresentation ],
        [ dct:description "The Asset Description Metadata Schema (ADMS) enables the description of information collected or paid by public administrations, ensuring it is made available in a human-readable format that fosters unrestricted reuse."@en ;
            dct:relation eira:OpenDataRepresentation ],
        [ dct:description "The Asset Description Metadata Schema (ADMS) details the characteristics of datasets, serving as the metadata layer that ensures assets can be indexed and understood in a human-readable format."@en ;
            dct:relation eira:MetadataDataObject ] ;
    dcat:theme "Data Architecture"@en,
        "Implementation Governance"@en,
        "Technology Architecture"@en .

cssvrsc:1c4f6d87cf0b9a0a74ee091663959b45e057a66785bcd0ab38d3b2d2b5a11a35 a cssv:Specification ;
    dct:relation [ dct:description "The mentioned ABB is implemented in Dataspace Protocol v 0.8 which is built on protocols located in the ISO/IEC 7498-1:1994 layers, like HTTPS."@en ;
            dct:relation eira:DataSpaceConnectorProviderApplicationService ],
        [ dct:description "The mentioned ABB is implemented in Dataspace Protocol v 0.8 which is built on protocols located in the ISO/IEC 7498-1:1994 layers, like HTTPS."@en ;
            dct:relation eira:DataSpaceConnectorConsumerApplicationService ],
        [ dct:description "The mentioned ABB is implemented in Dataspace Protocol v 0.8 which is built on protocols located in the ISO/IEC 7498-1:1994 layers, like HTTPS."@en ;
            dct:relation eira:DataSpaceConnectorApplicationService ],
        [ dct:description "The Dataspace Protocol v 0.8 defines a framework of specifications that supports secure and interoperable data sharing among entities, built on common web standards and governed by usage agreements. By enabling structured negotiation and access within federated systems, it contributes to formalised collaboration and shared governance practices—reinforcing the kinds of interoperability rules and cooperation mechanisms typically captured in organisational-level agreements for digital public services."@en ;
            dct:relation eira:OrganisationalInteroperabilityAgreementContract ],
        [ dct:description "The Dataspace Protocol provides technical specifications for structured data sharing and agreement negotiation within federated systems. This supports the kinds of contractual arrangements and operational commitments reflected in organisational agreements between entities or their affiliates."@en ;
            dct:relation eira:OrganisationalAgreementContract ],
        camssa:8f32ec706a46d2f07f98f81c4bfed1170e3952cc34b3ee7d35ab799428930627,
        camssa:d4dc68f7fe66e9ed756df40f66800221d454d6e6461a6e84072d28dcb1674663 ;
    dcat:theme "Implementation Governance"@en,
        "Technology Architecture"@en .

