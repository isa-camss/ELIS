    dct:relation [ dct:description "National-level requirement establishing minimum technical specifications for assurance levels in electronic identification."@en ;
            dct:relation eira:NationalLegalActRequirement ],
        [ dct:description "Business agnostic legal act defining milestones, goals and obligations involving interoperability aspects at European level."@en ;
            dct:relation eira:BindingInstrumentRequirement ],
        [ dct:description "Non-binding guidance proposing technical rules for eID assurance applicable in specific contexts."@en ;
            dct:relation eira:Non-bindingInstrumentRequirement ],
        [ dct:description "A binding EU legal act specifying minimum technical rules for eID assurance, introducing requirements impacting digital public services."@en ;
            dct:relation eira:LegalActRequirement ],
