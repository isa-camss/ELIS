cssvrsc:e26fcc022b94285e0ddc4f69d72ea42655bc3a7372447989b8a1516b0d108559 a cssv:Specification ;
    dct:relation [ dct:description "The JSON Lines specification is designed for storing and processing data within computer systems. In this context, it allows information to be encoded in UTF-8 format. Unlike traditional JSON, which typically stores data in a large array, JSON Lines enables the organisation of data in plain text files, with each line representing a valid JSON object. This structure simplifies parsing and supports efficient, line-by-line processing—ideal for large datasets and streaming applications."@en ;
            dct:relation eira:DataRepresentationRepresentation ],
        [ dct:description "The JSON Lines specification, as it is based on JSON, allows the syntax of stored data to be defined. This includes delimiters, identifiers, among other elements. However, while using JSON requires the entire document—with all information organised in a large array—to be uploaded, JSON Lines allows information to be read line by line, with syntax defined per line."@en ;
            dct:relation eira:DataSyntaxDataObject ] ;
    dcat:theme "Data Architecture"@en .

cssvrsc:e288942d7196a3cae9ff08b20b3b8bbe9340baadd87ba3be9be9571b264bf98b a cssv:Specification ;
    dct:relation [ dct:description "Microformats standardises the way data is presented on the web, ensuring that data is structured and encoded for storage, transmission, and processing."@en ;
            dct:relation eira:DataFormatDataObject ] ;
    dcat:theme "Data Architecture"@en .

cssvrsc:e33194f8a67103011e1220a24bd87c01924760e098594f86af74948a26a0feed a cssv:Specification ;
    dct:relation [ dct:description "SNMP provides a standardized method for monitoring and managing network devices. Management consoles use SNMP to collect data on device performance, status, and configuration, enabling administrators to oversee and control the network from a centralized interface"@en ;
            dct:relation eira:ManagementConsoleTechnologyService ] ;
    dcat:theme "Technology Architecture"@en .

cssvrsc:e3a490e2b7118f66895f5e5f9d5924479b9d940d9b2cbc80ce13540f94c369a6 a cssv:Specification ;
    dct:relation [ dct:description "The specification is a method to turn data into a alphanumeric string of fixed length. This provides the user with the capability to encode any data in a barcode, decode it by scanning software and passed to the host system without any need for an online connection."@en ;
            dct:relation eira:HashCodeDataObject ],
        [ dct:description "The specification provides the user with the capability to encode any data in a barcode, decode it by scanning software and passed to the host system without any need for an online connection. This allows for a simple exchange of information among an integrated system."@en ;
            dct:relation eira:DataExchangeApplicationService ],
        [ dct:description "The specification provides the user with the capability to encode any data in a barcode, decode it by scanning software and passed to the host system without any need for an online connection. This allows for a simple exchange of information among an integrated system."@en ;
            dct:relation eira:DataExchangeApplicationComponent ],
        [ dct:description "GS1 Digital Link is a global standard that connects physical products to digital information via web-based identifiers like QR codes. It enables secure and standardised access to product data such as ingredients, instructions, and traceability. By using web technologies, it facilitates sharing and linking structured product data online. The focus is on improving supply chain transparency and consumer information. It’s not a general content management system but a bridge between physical goods and their digital identities."@en ;
            dct:relation eira:LinkedDataRepresentation ] ;
    dcat:theme "Data Architecture"@en,
        "Technology Architecture"@en .

cssvrsc:e40e1dad713e4ac1d66f54e1b53cbbce61f57635e6aeeb82bc6eefb469303e01 a cssv:Specification ;
    dct:relation [ dct:description "GXDCH ensures secure, transparent data sharing and collaboration among research institutions, fostering trust and simplifying compliance with shared standards in the Gaia-X framework in the context of a data or service provider."@en ;
            dct:relation eira:DataSpaceConnectorProviderApplicationService ],
        [ dct:description "GXDCH ensures secure, transparent data sharing and collaboration among research institutions, fostering trust and simplifying compliance with shared standards in the Gaia-X framework."@en ;
            dct:relation eira:DataSpaceConnectorApplicationService ],
        [ dct:description "GXDCH standard facilitates secure, transparent logging of system events, enhancing data interoperability and trust in digital ecosystems."@en ;
            dct:relation eira:DataSpaceApplicationService ],
        [ dct:description "GXDCH standard facilitates secure, transparent logging of system events, enhancing data interoperability and trust in digital ecosystems."@en ;
            dct:relation eira:LogCollectionServiceTechnologyService ],
        [ dct:description "GXDCH standard facilitates secure, transparent logging of system events, enhancing data interoperability and trust in digital ecosystems."@en ;
            dct:relation eira:LoggerTechnologyService ],
        [ dct:description "GXDCH ensures secure, transparent data sharing and collaboration among research institutions, fostering trust and simplifying compliance with shared standards in the Gaia-X framework in the context of a data or service consumer."@en ;
            dct:relation eira:DataSpaceConnectorConsumerApplicationService ] ;
    dcat:theme "Technology Architecture"@en .

cssvrsc:e438965c54bc7f78e6ede46f4d408abe398302a3b33e374a9ed4662b8b44df77 a cssv:Specification ;
    dct:relation [ dct:description "XML 1.0 is a subset of SGML that enables generic SGML to be served, received, and processed on the Web in the way that is now possible with HTML."@en ;
            dct:relation eira:DataRepresentationRepresentation ],
        [ dct:description "XML is a specification that is used in defining the way in which data is put together with appropriate identifiers, delimiters, separator character(s), and other non-data characters to form messages."@en ;
            dct:relation eira:DataSyntaxDataObject ] ;
    dcat:theme "Data Architecture"@en .

cssvrsc:e438965c54bc7f78e6ede46f4d408abe398302a3b33e374a9ed4662b8b44df99 a cssv:Specification ;
    dct:relation [ dct:description "XML 1.1 is a subset of SGML that enables generic SGML to be served, received, and processed on the Web in the way that is now possible with HTML."@en ;
            dct:relation eira:DataRepresentationRepresentation ],
        [ dct:description "XML defines a flexible, hierarchical syntax for structuring data using tags, attributes, and schemas. As a data syntax object, it standardises how data structures are encoded, parsed, and validated across systems, supporting interoperability in messaging, document exchange, service interfaces, and configuration files. XML’s extensibility and schema-based validation make it widely suitable for cross-organisational information exchange and long-term data preservation."@en ;
            dct:relation eira:DataSyntaxDataObject ],
        camssa:74ecd64479f85251863f23f53392bae51524e571729b196dfd39350bbba5aeff,
        camssa:8c9b9c54f21176231185cf4455e3d23b6e3c3048d33ae408047c28088e4733f6,
        camssa:d1f7f0f04d5a8542ea3e1fbdceb5c5a598f4060f1a254ef731d2e90a43095b33 ;
    dcat:theme "Data Architecture"@en .

