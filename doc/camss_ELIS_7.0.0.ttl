            dct:relation eira:TechnicalInteroperabilityAgreementContract ] ;
    dcat:theme "Implementation Governance"@en .

cssvrsc:c0c17e1de73c07903a9570e61640078f01843c8d53c33faff94f7354f0b22d57 a cssv:Specification ;
