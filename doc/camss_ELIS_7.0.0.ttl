cssvrsc:dddff8544042eb988c47233f82dabea445e63f0cc63a8d4b3927aaa10a7a1829 a cssv:Specification ;
    dct:relation [ dct:description "Business agnostic legal act defining milestones, goals and obligations involving interoperability aspects, some of them with no legal obligation."@en ;
            dct:relation eira:Non-bindingInstrumentRequirement ],
        [ dct:description "National-level requirement identifying specifications applicable to interoperable public procurement."@en ;
            dct:relation eira:NationalLegalActRequirement ],
        [ dct:description "A European legal act identifying technical specifications for use in procurement."@en ;
            dct:relation eira:EuropeanLegalActRequirement ],
        [ dct:description "This Implementing Decision identifies ICT technical specifications that meet EU criteria for interoperability, openness, and market relevance, allowing them to be referenced within public procurement procedures. It provides legal certainty for contracting authorities by clarifying which non-harmonised ICT specifications may be used in tenders, promoting competition and avoiding vendor lock-in. As a legal act requirement, it establishes obligations and governance mechanisms that harmonise procurement practices across the EU, ensuring that publicly procured ICT systems are interoperable, secure, and based on widely recognised standards."@en ;
            dct:relation eira:LegalActRequirement ],
        [ dct:description "This Implementing Decision designates ICT technical specifications eligible for use in public procurement, guiding administrations toward interoperable, future-proof digital solutions."@en ;
            dct:relation eira:BindingInstrumentRequirement ] ;
    dcat:theme "Business Architecture"@en .

