cssvrsc:efb40789fe3ad96b26d88aeb5afa229851bc73b19b6a3d4b8220ef3a37fed1c7 a cssv:Specification ;
    dct:relation [ dct:description "National-level requirement establishing obligations to ensure accessibility of public sector websites and mobile apps."@en ;
            dct:relation eira:NationalLegalActRequirement ],
        [ dct:description "Non-binding guidance proposing accessibility principles applicable in specific domains."@en ;
            dct:relation eira:Non-bindingInstrumentRequirement ],
        [ dct:description "A European legal act defining obligations for accessibility of public sector sites and apps."@en ;
            dct:relation eira:EuropeanLegalActRequirement ],
        [ dct:description "This Directive mandates accessibility requirements for public-sector websites and mobile applications, defining interoperability-oriented obligations to ensure inclusive and harmonised digital access across the EU."@en ;
            dct:relation eira:BindingInstrumentRequirement ],
        [ dct:description "This Directive defines binding obligations for public bodies to ensure digital accessibility, supporting interoperable, inclusive online services that can be reliably accessed by all users, including persons with disabilities."@en ;
